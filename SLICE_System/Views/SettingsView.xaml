<UserControl x:Class="SLICE_System.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="#FDFBF7" FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TomatoRed" Color="#E74C3C"/>
        <SolidColorBrush x:Key="PizzaOrange" Color="#E67E22"/>
        <SolidColorBrush x:Key="CrustDark" Color="#2C1E16"/>
        <SolidColorBrush x:Key="DoughLight" Color="#FDFBF7"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7F8C8D"/>

        <Style x:Key="PremiumCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Color="#D35400" ShadowDepth="4" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource CrustDark}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#EAECEE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <fa:ImageAwesome Icon="Cogs" Height="24" Foreground="{StaticResource PizzaOrange}" Margin="0,0,10,0"/>
                    <TextBlock Text="System Settings" FontSize="28" FontWeight="Black" Foreground="{StaticResource CrustDark}"/>
                </StackPanel>
                <TextBlock Text="Manage enterprise branches and global operations network." FontSize="14" Foreground="{StaticResource TextMuted}" Margin="34,0,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource PremiumCard}" Padding="20,10" Background="{StaticResource CrustDark}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3E2A1F" CornerRadius="8" Width="40" Height="40" Margin="0,0,15,0">
                        <fa:ImageAwesome Icon="MapMarker" Height="18" Foreground="{StaticResource PizzaOrange}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TOTAL LOCATIONS" FontSize="10" FontWeight="Bold" Foreground="#BDC3C7"/>
                        <TextBlock Text="{Binding TotalBranches, StringFormat='{}{0:D2}'}" FontSize="24" FontWeight="Black" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PremiumCard}" Padding="25" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <fa:ImageAwesome Icon="Building" Height="16" Foreground="{StaticResource TomatoRed}" Margin="0,0,10,0"/>
                        <TextBlock Text="Active Branch Network" FontSize="18" FontWeight="Black" Foreground="{StaticResource CrustDark}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" 
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                              Background="Transparent" BorderThickness="0" RowHeight="55" AlternatingRowBackground="#FCF3EB" GridLinesVisibility="None">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,0,0,15"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#FAD7A1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FDEBD0"/>
                                        <Setter Property="Foreground" Value="{StaticResource CrustDark}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding BranchID}" Width="60" FontWeight="Bold" Foreground="{StaticResource PizzaOrange}"/>
                            <DataGridTextColumn Header="BRANCH NAME" Binding="{Binding BranchName}" Width="*" FontWeight="SemiBold" Foreground="{StaticResource CrustDark}"/>
                            <DataGridTextColumn Header="LOCATION ADDRESS" Binding="{Binding Location}" Width="2*" Foreground="{StaticResource TextMuted}"/>
                            <DataGridTextColumn Header="CONTACT NO." Binding="{Binding ContactNumber}" Width="*" Foreground="{StaticResource CrustDark}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PremiumCard}" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
                        <fa:ImageAwesome Icon="Edit" Height="16" Foreground="{StaticResource TomatoRed}" Margin="0,0,10,0"/>
                        <TextBlock Text="Branch Details" FontSize="18" FontWeight="Black" Foreground="{StaticResource CrustDark}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="STORE NAME" Foreground="{StaticResource PizzaOrange}" FontWeight="Bold" FontSize="11" Margin="5,0,0,5"/>
                        <Border Style="{StaticResource InputBorder}">
                            <TextBox Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}"/>
                        </Border>

                        <TextBlock Text="FULL ADDRESS" Foreground="{StaticResource PizzaOrange}" FontWeight="Bold" FontSize="11" Margin="5,0,0,5"/>
                        <Border Style="{StaticResource InputBorder}">
                            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}"/>
                        </Border>

                        <TextBlock Text="CONTACT NUMBER" Foreground="{StaticResource PizzaOrange}" FontWeight="Bold" FontSize="11" Margin="5,0,0,5"/>
                        <Border Style="{StaticResource InputBorder}">
                            <TextBox Text="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <Button Command="{Binding SaveCommand}" Height="45" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E67E22" Offset="0"/>
                                    <GradientStop Color="#D35400" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <fa:ImageAwesome Icon="Save" Height="14" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="SAVE BRANCH" Foreground="White" FontWeight="Black" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding DeleteCommand}" Background="#FEF5E7" Height="40" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#FAD7A1" BorderThickness="1">
                                            <TextBlock Text="DELETE" Foreground="{StaticResource TomatoRed}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding ClearCommand}" Background="#F8F9FA" Height="40" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#EAECEE" BorderThickness="1">
                                            <TextBlock Text="CLEAR" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
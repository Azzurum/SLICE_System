<Window x:Class="SLICE_System.Views.AboutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="About S.L.I.C.E." SizeToContent="Height" Width="650"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" MouseDown="Window_MouseDown">

    <Border CornerRadius="16" Background="White" Margin="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.25" Color="#2C3E50"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#2C3E50" CornerRadius="16,0,0,16">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="PieChart" Foreground="#E67E22" Height="60" Margin="0,0,0,20"/>

                    <TextBlock Text="S.L.I.C.E." Foreground="White" FontSize="36" FontWeight="Black" 
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="ENTERPRISE" Foreground="#95A5A6" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>

                    <Separator Width="40" Background="#E67E22" Height="3" Margin="0,30,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="SYSTEM INFORMATION" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="Version 1.0.0 (RC)" Foreground="#2D3436" FontSize="26" FontWeight="Light" Margin="0,5,0,25"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="Code" Foreground="#E67E22" Height="18" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Developed By" Foreground="#95A5A6" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="S.L.I.C.E. Development Team" Foreground="#2C3E50" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="GraduationCap" Foreground="#E67E22" Height="18" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Project Context" Foreground="#95A5A6" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="BS Information Technology Project" Foreground="#2C3E50" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="Institution" Foreground="#E67E22" Height="18" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Institution" Foreground="#95A5A6" FontSize="11" FontWeight="Bold"/>
                            <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left">
                                <TextBlock Text="San Sebastian College-Recoletos de Cavite" 
                                           Foreground="#2C3E50" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,25,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="© 2026 S.L.I.C.E. Systems Inc." Foreground="#BDC3C7" FontSize="11" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Content="Close" Click="Close_Click" Width="100" Height="38"
                            Background="#E67E22" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#D35400"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
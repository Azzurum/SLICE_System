<Window x:Class="SLICE_System.Views.Dialogs.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Reset Password" Height="500" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" 
        WindowStyle="None" AllowsTransparency="True" Background="#90000000" 
        FontFamily="Segoe UI" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White" Width="380" Height="440" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#000000" ShadowDepth="10" Opacity="0.25"/>
            </Border.Effect>

            <Grid Margin="35,30">
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Close_Click" Margin="0,-15,-15,0" ToolTip="Close">
                    <fa:ImageAwesome Icon="Times" Height="16" Foreground="#BDC3C7"/>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Background="#FFF3E0" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <fa:ImageAwesome Icon="Shield" Height="28" Foreground="#E67E22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ACCOUNT RECOVERY" FontSize="20" FontWeight="Black" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="pnlStep1" VerticalAlignment="Bottom" Height="220">
                    <TextBlock Text="Enter your registered email address. We will send you a 6-digit verification code." FontSize="13" Foreground="#7F8C8D" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="EMAIL ADDRESS" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,6"/>
                    <Border Background="#F8F9FA" BorderBrush="#EAECEE" BorderThickness="1.5" CornerRadius="8" Height="45" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <fa:ImageAwesome Icon="EnvelopeOutline" Height="16" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                            <TextBox x:Name="txtEmail" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="#2C3E50" VerticalContentAlignment="Center" Padding="5,0,15,0"/>
                        </Grid>
                    </Border>
                    <Button Content="SEND VERIFICATION CODE" Style="{StaticResource ModernBtn}" Background="#E67E22" Height="45" Click="SendCode_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#E67E22" ShadowDepth="2" Opacity="0.3"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="pnlStep2" VerticalAlignment="Bottom" Height="220" Visibility="Collapsed">
                    <TextBlock Text="Check your inbox. Enter the 6-digit security code sent to your email." FontSize="13" Foreground="#7F8C8D" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="SECURITY CODE" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,6"/>
                    <Border Background="#F8F9FA" BorderBrush="#EAECEE" BorderThickness="1.5" CornerRadius="8" Height="45" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <fa:ImageAwesome Icon="Lock" Height="18" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                            <TextBox x:Name="txtCode" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="22" FontWeight="Black" HorizontalContentAlignment="Center" Foreground="#E74C3C" VerticalContentAlignment="Center" Padding="0,0,45,0" MaxLength="6"/>
                        </Grid>
                    </Border>
                    <Button Content="VERIFY CODE" Style="{StaticResource ModernBtn}" Background="#27AE60" Height="45" Click="VerifyCode_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#27AE60" ShadowDepth="2" Opacity="0.3"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="pnlStep3" VerticalAlignment="Bottom" Height="220" Visibility="Collapsed">
                    <TextBlock Text="Verification successful! Please create a new secure password for your account." FontSize="13" Foreground="#27AE60" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="NEW PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,6"/>
                    <Border Background="#F8F9FA" BorderBrush="#EAECEE" BorderThickness="1.5" CornerRadius="8" Height="45" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <fa:ImageAwesome Icon="Key" Height="16" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                            <PasswordBox x:Name="txtNewPassword" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="#2C3E50" VerticalContentAlignment="Center" Padding="5,0,15,0"/>
                        </Grid>
                    </Border>
                    <Button Content="UPDATE PASSWORD" Style="{StaticResource ModernBtn}" Background="#2C3E50" Height="45" Click="ResetPassword_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#2C3E50" ShadowDepth="2" Opacity="0.3"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
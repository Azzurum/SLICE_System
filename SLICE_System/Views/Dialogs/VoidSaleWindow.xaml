<Window x:Class="SLICE_System.Views.Dialogs.VoidSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transaction History &amp; Voids" Height="500" Width="700"
        WindowStartupLocation="CenterOwner" Background="#F4F6F7" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Today's Completed Sales" FontSize="20" FontWeight="Black" Foreground="#2C3E50" Margin="0,0,0,15"/>

        <DataGrid x:Name="dgSales" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ref ID" Binding="{Binding ReferenceNumber}" Width="100"/>
                <DataGridTextColumn Header="Time" Binding="{Binding TransactionDate, StringFormat='HH:mm'}" Width="80"/>
                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding QuantitySold}" Width="50"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat='₱{0:N2}'}" Width="100" FontWeight="Bold"/>
                <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock Text="Reason for void:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtReason" Width="200" Height="35" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,15,0"/>
            <Button Content="VOID SELECTED SALE" Background="#C0392B" Foreground="White" FontWeight="Bold" Padding="15,0" Height="35" Cursor="Hand" Click="Void_Click"/>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="SLICE_System.Views.Dialogs.PaymentGatewayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Secure Payment Gateway" Height="700" Width="950"
        WindowStyle="None" AllowsTransparency="True" Background="#90000000"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PaymentMethodBtn" TargetType="Button">
            <Setter Property="Background" Value="#FDFDFD"/>
            <Setter Property="BorderBrush" Value="#E0E6ED"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F8FF"/>
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                    <Setter Property="Foreground" Value="#2980B9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White" Width="900" Height="640" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="15" Opacity="0.3" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1A252F" CornerRadius="20,0,0,20" Padding="35">
                    <StackPanel VerticalAlignment="Center">
                        <Border Background="#2C3E50" Width="70" Height="70" CornerRadius="35" Margin="0,0,0,25" HorizontalAlignment="Left">
                            <fa:ImageAwesome Icon="Lock" Height="28" Foreground="#ecf0f1"/>
                        </Border>

                        <TextBlock Text="TOTAL AMOUNT DUE" Foreground="#95A5A6" FontSize="12" FontWeight="Black"/>

                        <Viewbox MaxHeight="60" HorizontalAlignment="Left" Margin="0,5,0,30">
                            <TextBlock Text="{Binding TotalAmount, StringFormat='₱{0:N2}'}" Foreground="White" FontWeight="Black" FontSize="44"/>
                        </Viewbox>

                        <Separator Background="#34495E" Margin="0,0,0,30" Height="1"/>
                        <TextBlock Text="S.L.I.C.E. ENTERPRISE" Foreground="#BDC3C7" FontSize="14" FontWeight="Black"/>
                        <TextBlock Text="Payment Gateway Integration" Foreground="#7F8C8D" FontSize="12" Margin="0,5,0,0"/>
                        <TextBlock Text="v2.5 Secured Transaction" Foreground="#34495E" FontSize="10" Margin="0,20,0,0" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="40,30">
                    <Button Command="{Binding CloseCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,-10,-10,0">
                        <fa:ImageAwesome Icon="Times" Height="18" Foreground="#BDC3C7"/>
                    </Button>

                    <StackPanel Visibility="{Binding SelectionVis}" VerticalAlignment="Center">
                        <TextBlock Text="Select Payment Method" FontSize="26" FontWeight="Black" Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <TextBlock Text="Choose how the customer will settle the balance." Foreground="#95A5A6" Margin="0,0,0,30" FontSize="14"/>

                        <UniformGrid Columns="2">
                            <Button Command="{Binding SelectMethodCommand}" CommandParameter="Cash" Style="{StaticResource PaymentMethodBtn}">
                                <StackPanel>
                                    <fa:ImageAwesome Icon="Money" Height="30" Foreground="#27AE60" Margin="0,0,0,10"/>
                                    <TextBlock Text="Physical Cash" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding SelectMethodCommand}" CommandParameter="Credit / Debit Card" Style="{StaticResource PaymentMethodBtn}">
                                <StackPanel>
                                    <fa:ImageAwesome Icon="CreditCard" Height="28" Foreground="#2980B9" Margin="0,0,0,10"/>
                                    <TextBlock Text="Card Payment" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding SelectMethodCommand}" CommandParameter="GCash" Style="{StaticResource PaymentMethodBtn}">
                                <StackPanel>
                                    <fa:ImageAwesome Icon="MobilePhone" Height="34" Foreground="#3498DB" Margin="0,0,0,8"/>
                                    <TextBlock Text="GCash e-Wallet" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding SelectMethodCommand}" CommandParameter="Maya" Style="{StaticResource PaymentMethodBtn}">
                                <StackPanel>
                                    <fa:ImageAwesome Icon="CheckCircle" Height="28" Foreground="#27AE60" Margin="0,0,0,10"/>
                                    <TextBlock Text="PayMaya" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding InputVis}" VerticalAlignment="Center">
                        <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="-5,0,0,25">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="AngleLeft" Height="16" Foreground="#7F8C8D" Margin="0,0,8,0"/>
                                <TextBlock Text="Change Payment Method" Foreground="#7F8C8D" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding SelectedMethod}" FontSize="28" FontWeight="Black" Foreground="#2C3E50" Margin="0,0,0,25"/>

                        <StackPanel Visibility="{Binding IsCardPayment, Converter={StaticResource BoolToVis}}">
                            <Border Background="#F8F9FA" BorderBrush="#E0E6ED" BorderThickness="1" CornerRadius="12" Padding="30" Margin="0,0,0,25">
                                <StackPanel HorizontalAlignment="Center">
                                    <fa:ImageAwesome Icon="CreditCardAlt" Height="50" Foreground="#34495E" Margin="0,0,0,20"/>
                                    <TextBlock Text="AWAITING CARD TERMINAL" FontSize="15" FontWeight="Black" Foreground="#2C3E50" TextAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Please ask the customer to tap or insert their card on the physical terminal." 
                                               FontSize="13" Foreground="#7F8C8D" TextAlignment="Center" TextWrapping="Wrap" Width="320"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="AMOUNT TENDERED (₱)" FontSize="12" FontWeight="Bold" Foreground="#95A5A6" Margin="0,0,0,10"/>
                            <Border Background="#F8F9FA" BorderBrush="#E0E6ED" BorderThickness="2" CornerRadius="10" Margin="0,0,0,25" Height="75">
                                <TextBox Text="{Binding AmountTenderedStr, UpdateSourceTrigger=PropertyChanged}" FontSize="36" FontWeight="Bold" Foreground="#27AE60" Padding="20,0" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CHANGE DUE" FontSize="12" FontWeight="Bold" Foreground="#95A5A6" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding ChangeAmount, StringFormat='₱{0:N2}'}" FontSize="48" FontWeight="Black" Foreground="#2C3E50" Margin="0,0,0,20"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsEwalletPayment, Converter={StaticResource BoolToVis}}">
                            <Border Background="#F8F9FA" BorderBrush="#E0E6ED" BorderThickness="1" CornerRadius="12" Padding="25" Margin="0,0,0,25">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="{Binding QrCodeImage}" Width="200" Height="200" Margin="0,0,0,20" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="AWAITING CUSTOMER SCAN" FontSize="16" FontWeight="Black" Foreground="#2C3E50" TextAlignment="Center" Margin="0,0,0,8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button Command="{Binding ProcessCommand}" Content="CONFIRM &amp; COMPLETE TRANSACTION" Background="#27AE60" Style="{StaticResource PrimaryActionBtn}">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.4" Color="#27AE60"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ResultVis}" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Height="120" Width="120" Margin="0,0,0,30">
                            <fa:ImageAwesome Icon="CheckCircle" Foreground="#27AE60" Visibility="{Binding IsSuccessResult, Converter={StaticResource BoolToVis}}"/>
                            <fa:ImageAwesome Icon="TimesCircle" Foreground="#E74C3C" Visibility="{Binding IsFailedResult, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <TextBlock Text="{Binding ResultMessage}" FontSize="24" FontWeight="Black" Foreground="#2C3E50" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding ReferenceNumber, StringFormat='System Trace ID: {0}'}" FontSize="16" FontWeight="Bold" Foreground="#7F8C8D" TextAlignment="Center" Visibility="{Binding IsSuccessResult, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>